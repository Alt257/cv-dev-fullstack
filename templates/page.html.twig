<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/html">
<head>
    <meta charset="UTF-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <meta content="CV de Benoît Rataux – Développeur Full Stack Web & Mobile (.NET Core, Angular, Flutter)"
          name="description"/>

    <title>CV – Benoît Rataux | Développeur Full Stack</title>

    {# fonts #}
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet"/>
    <link href="assets/icons/stamp-on-document.png" rel="icon">

    {# styles #}
    <link href="styles/style.css" rel="stylesheet"/>
    <link href="styles/style-tablet.css" media="screen and (max-width: 768px)" rel="stylesheet"/>
    <link href="styles/style-mobile.css" media="screen and (max-width: 480px)" rel="stylesheet"/>
    <link href="styles/style-print.css" media="print" rel="stylesheet"/>
</head>
<body>

<!-- Boutons impression -->
<div class="print-buttons-wrapper">
    <button class="print-btn no-print" id="print-btn" onclick="printCV()">
        <span aria-hidden="true">🖨️ </span>Sauvegarder en PDF
    </button>
    <button class="print-btn no-print" id="print-bw-btn" onclick="printCVinBlackAndWhite()">
        <span aria-hidden="true">🖨️ </span>Imprimer en noir et blanc
    </button>
    <div class="print-hint no-print">
        <span aria-hidden="true">💡 </span>Astuce : utilisez Ctrl+P pour la version optimisée pour imprimer sur papier »
    </div>
</div>

{% block main %}{% endblock %}

<script>
    function resetPrintMode() {
        document.body.classList.remove('print-color', 'print-bw');
    }

    function printWithMode(modeClass) {
        resetPrintMode();
        document.body.classList.add(modeClass);
        window.print();
    }

    function printCV() {
        printWithMode('print-color');
    }

    function printCVinBlackAndWhite() {
        printWithMode('print-bw');
    }

    window.addEventListener('afterprint', resetPrintMode);

    const printMediaQuery = window.matchMedia('print');
    printMediaQuery.addEventListener('change', function (event) {
        if (!event.matches) {
            resetPrintMode();
        }
    });

    document.addEventListener('keydown', function (e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
            e.preventDefault();
            printCVinBlackAndWhite();
        }
    });
</script>

</body>
</html>
