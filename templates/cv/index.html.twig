{% extends 'page.html.twig' %}


{% block main %}
    <div class="page-wrapper">
        <div class="cv-page">


            {% include 'sidebar/_sidebar.html.twig' %}

            <!-- ══════════════════════════════════
                 CONTENU PRINCIPAL
            ══════════════════════════════════ -->
            <main class="main-content">
                <h1 class="main-title">{{ identity.title }}</h1>

                {% include 'cv/section/_profile.html.twig' with {
                    quote: profile.quote,
                    text: profile.content,
                } %}

                {% include 'cv/section/_experiences.html.twig' with {
                    experiences: experiences,
                } %}

                {% include 'cv/section/_volunteering.html.twig' with {
                    volunteering: volunteering,
                } %}

                {% include 'cv/section/_education.html.twig' with {
                    education: education,
                } %}

            </main>

        </div><!-- .cv-page -->
    </div><!-- .page-wrapper -->
{% endblock %}