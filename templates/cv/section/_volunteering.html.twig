{#
Composant : Section Bénévolat

Variables attendues :
- volunteering : array<int, array{
    title: string,
    date: string,
    company: string,
    location: string,
    bullets: array<int, string>
  }>
    Liste des expériences de bénévolat à afficher.

Exemple d’appel :
{% include 'cv/section/_volunteering.html.twig' with {
    volunteering: cv.volunteering,
} %}
#}

<!-- Bénévolat -->
<section aria-label="Bénévolat">
    <h2 class="section-title-main">Bénévolat</h2>

    {% for exp in volunteering %}
        <article class="exp-block">
            <div class="exp-header">
                <h3 class="exp-title">{{ exp.title }}</h3>
                <span class="exp-date">{{ exp.date }}</span>
            </div>
            <div class="exp-company">{{ exp.company }} | {{ exp.location }}</div>
            <div class="exp-note">
                {{ exp.note | markdown }}
            </div>
        </article>
    {% endfor %}
</section>