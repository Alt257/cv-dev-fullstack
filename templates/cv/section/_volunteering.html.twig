{#
Composant : Section Bénévolat

Variables attendues :
- volunteering : array<int, array{
    title: string,
    date: string,
    company: string,
    location: string,
    bullets: array<int, string>
  }>
    Liste des expériences de bénévolat à afficher.

Exemple d’appel :
{% include 'cv/section/_volunteering.html.twig' with {
    volunteering: cv.volunteering,
} %}
#}

<!-- Bénévolat -->
<section class="section main-section section--volunteering" aria-label="Bénévolat">
    <h2 class="section-title section-title--main">Bénévolat</h2>

    {% for exp in volunteering %}
        <article class="exp-block">
            <div class="exp-header">
                <h3 class="exp-title">
                    {% include 'shared/_text.html.twig' with {
                        text: exp.title,
                        href: exp.title_href,
                    } only %}
                </h3>
                <span class="exp-date">{{ exp.date }}</span>
            </div>

            <div class="exp-company">
                {% include 'shared/_text.html.twig' with {
                    text: exp.company,
                    href: exp.company_href,
                } only %}
                | {{ exp.location }}</div>
            <div class="exp-note">
                {{ exp.note | markdown }}
            </div>
        </article>
    {% endfor %}
</section>