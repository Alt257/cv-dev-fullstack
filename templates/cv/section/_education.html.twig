{#
Composant : Section Formation

Variables attendues :
- education : array<int, array{
    degree: string,
    date: string,
    school: string,
    location: string,
    note: string|null
  }>
    Liste des formations à afficher.

Exemple d’appel :
{% include 'cv/section/_education.html.twig' with {
    education: cv.education,
} %}
#}

<!-- Formation -->
<section class="section section--education" aria-label="Formation">
    <h2 class="section-title section-title--main">Formation</h2>

    {% for item in education %}
        <article class="formation-block">
            <div class="exp-header">

                <h3 class="formation-degree">
                    {% include 'shared/_text.html.twig' with {
                        text: item.degree,
                        href: item.degree_href,
                    } only %}
                </h3>

                <span class="exp-date">{{ item.date }}</span>
            </div>

            <div class="formation-school">
                {% include 'shared/_text.html.twig' with {
                    text: item.school,
                    href: item.school_href,
                } only %}
                | {{ item.location }}
            </div>
            {% if item.note is not empty %}
                <div class="formation-note">{{ item.note | markdown }}</div>
            {% endif %}
        </article>
    {% endfor %}
</section>