{#
Composant : Section Expériences professionnelles

Variables attendues :
- experiences : array<int, array{
    title: string,
    date: string,
    company: string,
    location: string,
    bullets: array<int, string>
  }>
    Liste des expériences professionnelles à afficher.

Exemple d’appel :
{% include 'cv/section/_experiences.html.twig' with {
    experiences: cv.experiences,
} %}
#}

<!-- Expériences professionnelles -->
<section class="section main-section section--experiences" aria-label="Expériences professionnelles">
    <h2 class="section-title section-title--main">Expériences Professionnelles</h2>

    {% for exp in experiences %}
        <article class="exp-block">
            <div class="exp-header">
                <h2 class="exp-title">
                    {% include 'shared/_text.html.twig' with {
                        text: exp.title,
                        href: exp.title_href,
                    } only %}
                </h2>
                <span class="exp-date">{{ exp.date }}</span>
            </div>

            <div class="exp-company">
                {% include 'shared/_text.html.twig' with {
                    text: exp.company,
                    href: exp.company_href,
                } only %}
                | {{ exp.location }}
            </div>
            <div class="exp-note">
                {{ exp.note | markdown }}
            </div>
        </article>
    {% endfor %}
</section>