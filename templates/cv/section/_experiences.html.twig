{#
Composant : Section Expériences professionnelles

Variables attendues :
- experiences : array<int, array{
    title: string,
    date: string,
    company: string,
    location: string,
    bullets: array<int, string>
  }>
    Liste des expériences professionnelles à afficher.

Exemple d’appel :
{% include 'cv/section/_experiences.html.twig' with {
    experiences: cv.experiences,
} %}
#}

<!-- Expériences professionnelles -->
<section aria-label="Expériences professionnelles">
    <h2 class="section-title-main">Expériences Professionnelles</h2>

    {% for exp in experiences %}
        <article class="exp-block">
            <div class="exp-header">
                <h2 class="exp-title">{{ exp.title }}</h2>
                <span class="exp-date">{{ exp.date }}</span>
            </div>
            <div class="exp-company">{{ exp.company }} | {{ exp.location }}</div>
            <div class="exp-note">
                {{ exp.note | markdown }}
            </div>
        </article>
    {% endfor %}
</section>