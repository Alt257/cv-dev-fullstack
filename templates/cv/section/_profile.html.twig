{#
Composant : Section Profil

Variables attendues :
- quote : string|null
    Citation affichée dans un bloc <blockquote>.
    Si la valeur est null, la citation n’est pas affichée.

- text : string|null
    Texte principal du profil.
    Le contenu est interprété comme du Markdown grâce au filtre `markdown`.

Exemple d’appel :
{% include 'cv/section/_profile.html.twig' with {
    quote: profile.quote,
    text: profile.content,
} %}
#}

<!-- Profil -->
<section class="section main-section section--profile" aria-label="Profil">
    <h2 class="section-title section-title--main">Profil</h2>

    <article class="profil-box">

        {% if quote is not null %}
            <blockquote class="quote">
                {{ quote }}
            </blockquote>
        {% endif %}

        {{ text | markdown }}
        {#        C'est cette logique qui guide mon travail #}
        {#        de développeur full stack. J'ai de l'expérience en <b>Symfony</b>, <b>Flutter</b>, #}
        {#        <b>API REST</b> et aujourd'hui, je me forme sur <b>.NET Core</b> et <b>Angular</b>. #}
        {#        Curieux, collaboratif et attaché aux bonnes pratiques (<b>TDD</b>, <b>SOLID</b>, <b>CI/CD</b>), #}
        {#        je #}
        {#        m'investis dans des #}
        {#        projets où la qualité du code rime avec l'impact réel sur les utilisateurs. #}
        {#        Ma vraie force : percevoir les connexions entre des éléments disparates et #}
        {#        concevoir comment les faire interagir de manière innovante et ingénieuse. #}
    </article>
</section>