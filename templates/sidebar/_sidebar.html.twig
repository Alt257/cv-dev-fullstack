<!-- ══════════════════════════════════
                 SIDEBAR GAUCHE
            ══════════════════════════════════ -->
<aside class="sidebar">

    <!-- En-tête -->
    <div class="sidebar-header">
        <h1 class="sidebar-name">{{ identity.firstname }}<br>{{ identity.lastname }}</h1>

        <div aria-hidden="true" class="dot-pattern">
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
        </div>
    </div>

    {% include 'sidebar/section/_status.html.twig' %}

    {% include 'sidebar/section/_contact.html.twig' %}


    <!-- Compétences techniques -->
    <section aria-label="Compétences techniques">
        <div class="section-title">Compétences Techniques</div>

        <div class="sidebar-label">Langages</div>
        <div class="pill-group">
            <span class="pill">C#</span>
            <span class="pill">TypeScript</span>
            <span class="pill">Dart</span>
            <span class="pill">JavaScript</span>
            <span class="pill">PHP</span>
            <span class="pill">Java</span>
            <span class="pill">SQL</span>
            <span class="pill">HTML/CSS</span>
        </div>

        <div class="sidebar-label">Frameworks &amp; Libs</div>
        <div class="pill-group">
            <span class="pill">.NET Core</span>
            <span class="pill">Angular</span>
            <span class="pill">Flutter</span>
            <span class="pill">Ionic</span>
            <span class="pill">Symfony</span>
        </div>

        <div class="sidebar-label">Outils &amp; DevOps</div>
        <div class="pill-group">
            <span class="pill">Docker</span>
            <span class="pill">Git</span>
            <span class="pill">Linux</span>
            <span class="pill">Apache</span>
            <span class="pill">SSH</span>
            <span class="pill">REST API</span>
        </div>

        <div class="sidebar-label">Pratiques</div>
        <div class="pill-group">
            <span class="pill">TDD</span>
            <span class="pill">SOLID</span>
            <span class="pill">Design Patterns</span>
            <span class="pill">Tests unitaires</span>
            <span class="pill">Tests d'intégration</span>
            <span class="pill">CI/CD</span>
        </div>
    </section>

    <!-- Langues -->
    <section aria-label="Langues">
        <div class="section-title">Langues</div>
        <p class="lang-item">🇫🇷 Français — <strong>Natif</strong></p>
        <p class="lang-item">🇬🇧 Anglais — <strong>Professionnel (B2)</strong></p>
    </section>

    <!-- Aptitudes -->
    <section aria-label="Aptitudes">
        <div class="section-title">Aptitudes</div>
        <ul class="aptitude-list" style="list-style:none;">
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Travail en équipe &amp; collaboration
            </li>
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Autonomie &amp; prise d'initiative
            </li>
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Rigueur &amp; sens du détail
            </li>
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Communication claire
            </li>
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Adaptabilité &amp; curiosité
            </li>
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                Pensée systémique &amp; architecture
            </li>
        </ul>
    </section>

    <!-- Intérêts -->
    <section aria-label="Intérêts">
        <div class="section-title">Intérêts</div>
        <ul class="interest-list" style="list-style:none;">
            <li class="interest-item">🎭 Théâtre d'improvisation (troupe K.A.O.S.)</li>
            <li class="interest-item">📡 Veille tech (TDD, API, sécurité, IA)</li>
            <li class="interest-item">🎲 Jeux de rôle &amp; création de décors</li>
            <li class="interest-item">🎵 Musique &amp; sculpture</li>
        </ul>
    </section>

</aside>