{#
Composant : Section Langues

Rôle :
Affiche les langues parlées avec un drapeau, un nom et un niveau.

Variables attendues :
- languages : array
    Liste des langues à afficher.

    Chaque élément contient :
    - item.flag : string
        Drapeau ou icône de la langue.

    - item.name : string
        Nom de la langue.

    - item.level : string
        Niveau de maîtrise.
        Exemple : `Natif`, `Professionnel (B2)`.

Exemple d’appel :
{% include 'sidebar/section/_languages.html.twig' %}
#}

<!-- Langues -->
<section class="section section--languages" aria-label="Langues">
    <h2 class="section-title sidebar-section-title">Langues</h2>

    <ul class="lang-list">
        {% for item in languages %}
            <li class="lang-item">
                {{ item.flag }} {{ item.name }}

                {% if item.level is not null %}
                    — <strong>{{ item.level }}</strong>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</section>