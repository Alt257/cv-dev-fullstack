<!-- Contact -->
<section aria-label="Contact">
    <div class="section-title">Contact</div>
    <ul class="contact-list" style="list-style:none;">

        {% for item in contact %}
            <li class="contact-item">

                {% include 'shared/_icon.html.twig' with {
                    class: 'contact-icon',
                    icon: item.icon,
                    iconImage: item.iconImage,
                } only %}

                {# Texte avec un lien si disponible #}
                {% if item.href is not null %}
                    <a href="{{ item.herf }}">
                        {{ item.text }}
                    </a>

                {% else %}
                    {{ item.text }}
                {% endif %}

            </li>
        {% endfor %}
    </ul>
</section>
