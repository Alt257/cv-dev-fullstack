<section aria-label="Contact">
    <div class="section-title">Contact</div>
    <ul class="contact-list" style="list-style:none;">
        {% for item in contact %}
            <li class="contact-item">

                {# Choix de la méthode pour afficher l'icone #}
                {% if item.icon is not null %}
                    <span aria-hidden="true"
                          class="contact-icon"
                    >{{ item.icon }}</span>

                {% elseif item.iconImage is not null %}
                    <img aria-hidden="true"
                         class="contact-icon"
                         src="{{ item.iconImage }}"
                         alt=""
                    >
                {% endif %}

                {# Texte avec un lien si disponible #}
                {% if item.href is not null %}
                    <a href="{{ item.href }}">
                        {{ item.text }}
                    </a>

                {% else %}
                    {{ item.text }}
                {% endif %}

            </li>
        {% endfor %}
    </ul>
</section>