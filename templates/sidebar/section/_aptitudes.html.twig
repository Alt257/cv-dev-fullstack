{#
Composant : Section Aptitudes

Rôle :
Affiche une liste d’aptitudes humaines, professionnelles ou comportementales.

Variables attendues :
- aptitudes : array<string>
    Liste des aptitudes à afficher.
    Chaque élément est une chaîne de caractères.

Exemple d’appel :
{% include 'sidebar/section/_aptitudes.html.twig' %}
#}

<!-- Aptitudes -->
<section class="section section--aptitudes" aria-label="Aptitudes">
    <h2 class="section-title section-title--side">Aptitudes</h2>

    <ul class="aptitude-list" style="list-style:none;">
        {% for item in aptitudes %}
            <li class="aptitude-item">
                <div aria-hidden="true" class="aptitude-dot"></div>
                {{ item }}
            </li>
        {% endfor %}
    </ul>
</section>
